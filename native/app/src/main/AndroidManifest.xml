<?xml version="1.0" encoding="utf-8"?>
<!--
  Dev-сборка нативного пути. Свой пакет (com.glassnotes.dev), стоит рядом с боевым
  приложением. Диагностический вход для проверки без микрофона — extra-поле wave_test
  при запуске MainActivity: прогоняет алгоритм полос синтетическим сигналом и пишет
  результат в лог (см. WaveSelfTest). Двух дефисов подряд в комментарии быть не должно:
  это недопустимо в XML и роняет разбор манифеста.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-feature
        android:name="android.hardware.microphone"
        android:required="true" />

    <application
        android:allowBackup="false"
        android:label="GlasNote (dev)"
        android:theme="@style/Theme.GlasNoteDev">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="GlasNote (dev)"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
